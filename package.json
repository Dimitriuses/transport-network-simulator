{
  "name": "transport-network-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A simulation game about integration engineering",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"src/*/test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node --disable-warning=ExperimentalWarning src/schema/scripts/generate-openapi.ts",
    "contract:check": "node --disable-warning=ExperimentalWarning src/schema/scripts/generate-openapi.ts --check",
    "check": "npm run lint && npm run typecheck && npm run contract:check && npm test",
    "world:build": "cd tools && uv run python -m worldbuild",
    "demo": "node --disable-warning=ExperimentalWarning src/server/src/demo.ts",
    "calibrate": "node --disable-warning=ExperimentalWarning src/scoring/scripts/calibrate.ts",
    "world:generate": "node --disable-warning=ExperimentalWarning scripts/generate-world.mjs",
    "audit": "node --disable-warning=ExperimentalWarning src/projections/scripts/audit.ts",
    "realism": "node --disable-warning=ExperimentalWarning src/projections/scripts/realism.ts",
    "docs": "node --disable-warning=ExperimentalWarning src/projections/scripts/docs.ts",
    "gates": "node --disable-warning=ExperimentalWarning src/scoring/scripts/gates.ts",
    "clearance": "node --disable-warning=ExperimentalWarning src/scoring/scripts/clearance.ts",
    "tune": "node --disable-warning=ExperimentalWarning src/refplayer/scripts/tune.ts",
    "transfer": "node --disable-warning=ExperimentalWarning src/scoring/scripts/transfer.ts",
    "profile": "node --disable-warning=ExperimentalWarning src/scoring/scripts/profile.ts",
    "calibrate:tier": "node --disable-warning=ExperimentalWarning src/scoring/scripts/calibrate-tier.ts",
    "ablate": "node --disable-warning=ExperimentalWarning src/scoring/scripts/gates.ts",
    "conformance": "node --disable-warning=ExperimentalWarning src/conformance/scripts/check.ts",
    "probe": "node --disable-warning=ExperimentalWarning src/scoring/scripts/probe.ts",
    "horizon": "node --disable-warning=ExperimentalWarning src/scoring/scripts/horizon.ts",
    "stability": "node --disable-warning=ExperimentalWarning src/scoring/scripts/stability.ts",
    "failures": "node --disable-warning=ExperimentalWarning src/scoring/scripts/failures.ts",
    "identifiability": "node --disable-warning=ExperimentalWarning src/scoring/scripts/identifiability.ts",
    "symptoms": "node --disable-warning=ExperimentalWarning src/scoring/scripts/symptoms.ts",
    "fallback": "node --disable-warning=ExperimentalWarning src/scoring/scripts/fallback.ts",
    "leak": "node --disable-warning=ExperimentalWarning src/scoring/scripts/leak.ts",
    "information": "node --disable-warning=ExperimentalWarning src/scoring/scripts/information.ts",
    "lead": "node --disable-warning=ExperimentalWarning src/scoring/scripts/lead.ts",
    "headroom": "node --disable-warning=ExperimentalWarning src/scoring/scripts/headroom.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "yaml": "^2.7.0"
  }
}

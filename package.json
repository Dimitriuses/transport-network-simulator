{
  "name": "transport-network-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A simulation game about integration engineering",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "test": "node --test \"src/*/test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node src/schema/scripts/generate-openapi.ts",
    "contract:check": "node src/schema/scripts/generate-openapi.ts --check",
    "check": "npm run lint && npm run typecheck && npm run contract:check && npm test",
    "world:build": "cd tools && uv run python -m worldbuild",
    "demo": "node src/server/src/demo.ts",
    "calibrate": "node src/scoring/scripts/calibrate.ts",
    "audit": "node src/projections/scripts/audit.ts",
    "gates": "node src/scoring/scripts/gates.ts",
    "ablate": "node src/scoring/scripts/gates.ts",
    "conformance": "node src/conformance/scripts/check.ts",
    "probe": "node src/scoring/scripts/probe.ts",
    "horizon": "node src/scoring/scripts/horizon.ts",
    "stability": "node src/scoring/scripts/stability.ts",
    "failures": "node src/scoring/scripts/failures.ts",
    "identifiability": "node src/scoring/scripts/identifiability.ts",
    "symptoms": "node src/scoring/scripts/symptoms.ts",
    "headroom": "node src/scoring/scripts/headroom.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "yaml": "^2.7.0"
  }
}
